      <parent>wrist_3_link</parent>
      <child>suction_cup_link</child>
    </joint>

    <link name="suction_tcp_link">
      <pose relative_to="fixed_suction_tcp">0 0 0 0 0 0</pose>
    </link>
    <joint name="fixed_suction_tcp" type="fixed">
      <pose relative_to="suction_cup_link">0 0 0.214 0 0 0</pose>
      <parent>suction_cup_link</parent>
      <child>suction_tcp_link</child>
    </joint>

    <!-- Joint state publisher for Gazebo visualization -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher"/>

    <!-- Joint position controllers used by the ROS<->GZ bridge path -->
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>shoulder_pan_joint</joint_name>
      <topic>/model/CS612_arm/joint/shoulder_pan_joint/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>380</p_gain>
      <i_gain>3.0</i_gain>
      <d_gain>90</d_gain>
      <i_max>80</i_max>
      <i_min>-80</i_min>
      <cmd_max>436</cmd_max>
      <cmd_min>-436</cmd_min>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>shoulder_lift_joint</joint_name>
      <topic>/model/CS612_arm/joint/shoulder_lift_joint/0/cmd_pos</topic>
      <initial_position>-1.5708</initial_position>
      <p_gain>1300</p_gain>
      <i_gain>26</i_gain>
      <d_gain>280</d_gain>
      <i_max>436</i_max>
      <i_min>-436</i_min>
      <cmd_max>436</cmd_max>
      <cmd_min>-436</cmd_min>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>elbow_joint</joint_name>
      <topic>/model/CS612_arm/joint/elbow_joint/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>500</p_gain>
      <i_gain>10</i_gain>
      <d_gain>110</d_gain>
