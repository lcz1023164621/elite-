<?xml version="1.0"?>
<sdf version="1.7">
  <model name="CS612">
    <static>false</static>
    <!-- base_link 固定到世界坐标系，防止机械臂因重力倒下 -->
    <joint name="world_fixed" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <!-- base_link -->
    <link name="base_link">
      <inertial>
        <pose>5.67149240033586e-05 -0.000105244825639109 0.0659791955027099 0 0 0</pose>
        <mass>0.948882914788405</mass>
        <inertia>
          <ixx>0.00296071190840501</ixx>
          <ixy>-1.01895818620175e-06</ixy>
          <ixz>5.26854170304019e-06</ixz>
          <iyy>0.00262218735357496</iyy>
          <iyz>-2.89514354564923e-06</iyz>
          <izz>0.00399062567997713</izz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="base_link_collision">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- link1 -->
    <link name="link1">
      <pose relative_to="Joint1">0 0 0 0 0 0</pose>
      <inertial>
        <pose>9.3e-05 -0.02697 -0.02115 0 0 0</pose>
        <mass>6.83</mass>
        <inertia>
          <ixx>0.039228</ixx>
          <ixy>-2.8388e-05</ixy>
          <ixz>3.9289e-05</ixz>
          <iyy>0.025078</iyy>
          <iyz>-0.00028825</iyz>
          <izz>0.037499</izz>
        </inertia>
      </inertial>
      <visual name="link1_visual">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link1.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="link1_collision">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link1.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="Joint1" type="revolute">
      <!-- 将 Joint1 零位直接定义为当前所需朝向，避免启动后再用 initial_position 补转 90 度 -->
      <pose relative_to="base_link">0 0 0.193 0 0 1.5708</pose>
      <parent>base_link</parent>
      <child>link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>436</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics><damping>5</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- link2 -->
    <link name="link2">
      <pose relative_to="Joint2">0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.2304 -3.9e-05 0.16068 0 0 0</pose>
        <mass>13.037</mass>
        <inertia>
          <ixx>0.3734</ixx>
          <ixy>-5.985e-05</ixy>
          <ixz>-0.5014</ixz>
          <iyy>2.0187</iyy>
          <iyz>-0.00013287</iyz>
          <izz>1.681</izz>
        </inertia>
      </inertial>
      <visual name="link2_visual">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link2.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="link2_collision">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link2.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="Joint2" type="revolute">
      <pose relative_to="link1">0 0 0 1.5708 1.5708 0</pose>
      <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>436</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics><damping>10</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- link3 -->
    <link name="link3">
      <pose relative_to="Joint3">0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.2998 1.3e-05 0.06176 0 0 0</pose>
        <mass>4.827</mass>
        <inertia>
          <ixx>0.030106</ixx>
          <ixy>-1.25e-05</ixy>
          <ixz>-0.076554</ixz>
          <iyy>0.76404</iyy>
          <iyz>1.326e-06</iyz>
          <izz>0.7421</izz>
        </inertia>
      </inertial>
      <visual name="link3_visual">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link3.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.79216 0.81961 0.93333 1</ambient>
          <diffuse>0.79216 0.81961 0.93333 1</diffuse>
        </material>
      </visual>
      <collision name="link3_collision">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link3.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="Joint3" type="revolute">
      <pose relative_to="link2">-0.615 0 0 0 0 0</pose>
      <parent>link2</parent>
      <child>link3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>207</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics><damping>5</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- link4 -->
    <link name="link4">
      <pose relative_to="Joint4">0 0 0 0 0 0</pose>
      <inertial>
        <pose>1e-05 -0.0148 -0.01682 0 0 0</pose>
        <mass>2.315</mass>
        <inertia>
          <ixx>0.0060891</ixx>
          <ixy>1.219e-06</ixy>
          <ixz>-4.067e-06</ixz>
          <iyy>0.0049703</iyy>
          <iyz>-1.2747e-05</iyz>
          <izz>0.0033067</izz>
        </inertia>
      </inertial>
      <visual name="link4_visual">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link4.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.79216 0.81961 0.93333 1</ambient>
          <diffuse>0.79216 0.81961 0.93333 1</diffuse>
        </material>
      </visual>
      <collision name="link4_collision">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link4.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="Joint4" type="revolute">
      <pose relative_to="link3">-0.571 0 0.1775 0 0 -1.5708</pose>
      <parent>link3</parent>
      <child>link4</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>66</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics><damping>10</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- link5 -->
    <link name="link5">
      <pose relative_to="Joint5">0 0 0 0 0 0</pose>
      <inertial>
        <pose>-1.3e-05 0.015559 -0.011803 0 0 0</pose>
        <mass>2.195</mass>
        <inertia>
          <ixx>0.004638045</ixx>
          <ixy>1.311e-06</ixy>
          <ixz>3.829e-06</ixz>
          <iyy>0.003507337</iyy>
          <iyz>1.4183e-05</iyz>
          <izz>0.003129668</izz>
        </inertia>
      </inertial>
      <visual name="link5_visual">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link5.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.79216 0.81961 0.93333 1</ambient>
          <diffuse>0.79216 0.81961 0.93333 1</diffuse>
        </material>
      </visual>
      <collision name="link5_collision">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link5.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="Joint5" type="revolute">
      <pose relative_to="link4">0 -0.118 0 1.5708 0 0</pose>
      <parent>link4</parent>
      <child>link5</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>66</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics><damping>10</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- link6 -->
    <link name="link6">
      <pose relative_to="Joint6">0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.001704 -0.000705 -0.039231 0 0 0</pose>
        <mass>0.616</mass>
        <inertia>
          <ixx>0.0016942</ixx>
          <ixy>1.27e-07</ixy>
          <ixz>1.9782e-05</ixz>
          <iyy>0.0017123</iyy>
          <iyz>7.7e-06</iyz>
          <izz>0.0005701</izz>
        </inertia>
      </inertial>
      <visual name="link6_visual">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link6.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="link6_collision">
        <geometry>
          <mesh>
            <uri>file:///mnt/e/gazebo_projects/my_first_world/my_arms/meshes/link6.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="Joint6" type="revolute">
      <pose relative_to="link5">0 0.1103 0 -1.5708 0 0</pose>
      <parent>link5</parent>
      <child>link6</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>66</effort>
          <velocity>6.0</velocity>
        </limit>
        <dynamics><damping>10</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!--
      末端工具：link6.STL 尖端在 z=-0.043 m，关节原点置于该法兰面（与 URDF 一致）。
      joint_suction_cup 绕 X 旋转 180°，因此 suction_cup_link 局部 +Z 才是“朝法兰外侧”。
    -->
    <link name="suction_cup_link">
      <pose relative_to="joint_suction_cup">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.012 0 0 0</pose>
        <mass>0.06</mass>
        <inertia>
          <ixx>2e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2e-05</iyy>
          <iyz>0</iyz>
          <izz>2.5e-05</izz>
        </inertia>
      </inertial>
      <visual name="flange_adapter">
        <pose>0 0 -0.0075 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.015</length>
            <radius>0.022</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.72 0.75 1</ambient>
          <diffuse>0.78 0.78 0.8 1</diffuse>
        </material>
      </visual>
      <visual name="vacuum_pad">
        <pose>0 0 -0.018 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.006</length>
            <radius>0.046</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <!--
        吸附碰撞体使用“薄盘”而非厚圆柱：
        1) 仅保留底面附近可接触区域，显著降低侧壁接触导致的误吸附；
        2) 局部 +Z 映射到法兰外侧，因此碰撞盘中心设在 z=+0.023m，其底面仍对应外侧 0.024m 接触偏移。
      -->
      <collision name="suction_pad_collision">
        <pose>0 0 -0.021 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.002</length>
            <radius>0.040</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="joint_suction_cup" type="fixed">
      <pose relative_to="link6">0 0 -0.043 0 0 0</pose>
      <parent>link6</parent>
      <child>suction_cup_link</child>
    </joint>

    <!-- 关节状态发布器：GUI JointPositionController 需要它来读取当前角度 -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <!--
      PID 设计原则（临界阻尼，防止超调）：
        Joint2 负载最重(≈23kg×0.5m=113Nm)，J≈2 kg·m²  → P=500, D=2√(500×2)≈63→取80
        Joint3 负载中等(≈10kg×0.3m=30Nm), J≈0.8 kg·m² → P=300, D=2√(300×0.8)≈31→取50
        Joint4/5  腕部(≈5kg×0.12m=6Nm),   J≈0.01kg·m² → P=200, D=2√(200×0.01)≈3→取20
        Joint1/6  轴向旋转，无重力力矩                  → P=200, D=20
      cmd_max = effort limit（与 joint limit 一致）
      i_gain 适当小，防止积分饱和
    -->

    <!-- Joint1：绕竖轴，无重力力矩 -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>Joint1</joint_name>
      <topic>/model/CS612_arm/joint/Joint1/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>380</p_gain>
      <i_gain>3.0</i_gain>
      <d_gain>90</d_gain>
      <i_max>80</i_max>
      <i_min>-80</i_min>
      <cmd_max>436</cmd_max>
      <cmd_min>-436</cmd_min>
    </plugin>

    <!-- Joint2：承受全臂重量，需最大力矩，用临界阻尼防超调 -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>Joint2</joint_name>
      <topic>/model/CS612_arm/joint/Joint2/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>1100</p_gain>
      <i_gain>22</i_gain>
      <d_gain>240</d_gain>
      <i_max>420</i_max>
      <i_min>-420</i_min>
      <cmd_max>436</cmd_max>
      <cmd_min>-436</cmd_min>
    </plugin>

    <!-- Joint3：承受前臂重量 -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>Joint3</joint_name>
      <topic>/model/CS612_arm/joint/Joint3/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>420</p_gain>
      <i_gain>7</i_gain>
      <d_gain>95</d_gain>
      <i_max>200</i_max>
      <i_min>-200</i_min>
      <cmd_max>207</cmd_max>
      <cmd_min>-207</cmd_min>
    </plugin>

    <!-- Joint4：腕部旋转，小惯量关节用低P高D防振荡 -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>Joint4</joint_name>
      <topic>/model/CS612_arm/joint/Joint4/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>180</p_gain>
      <i_gain>1.5</i_gain>
      <d_gain>38</d_gain>
      <i_max>40</i_max>
      <i_min>-40</i_min>
      <cmd_max>66</cmd_max>
      <cmd_min>-66</cmd_min>
    </plugin>

    <!-- Joint5：腕部俯仰，适度提高 P/D，减少末点贴合阶段的残余误差 -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>Joint5</joint_name>
      <topic>/model/CS612_arm/joint/Joint5/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>240</p_gain>
      <i_gain>1.5</i_gain>
      <d_gain>52</d_gain>
      <i_max>40</i_max>
      <i_min>-40</i_min>
      <cmd_max>66</cmd_max>
      <cmd_min>-66</cmd_min>
    </plugin>

    <!-- Joint6：末端旋转，轻微提高阻尼与刚度，减少吸盘姿态抖动 -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>Joint6</joint_name>
      <topic>/model/CS612_arm/joint/Joint6/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>360</p_gain>
      <i_gain>4.0</i_gain>
      <d_gain>82</d_gain>
      <i_max>60</i_max>
      <i_min>-60</i_min>
      <cmd_max>66</cmd_max>
      <cmd_min>-66</cmd_min>
    </plugin>

    <!-- 吸盘：DetachableJoint 在 attach/detach 话题上创建/解除与目标物的固定约束（社区常用真空近似） -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>suction_cup_link</parent_link>
      <child_model>rect_pickup</child_model>
      <child_link>box_link</child_link>
      <attach_topic>/cs612/suction/attach</attach_topic>
      <detach_topic>/cs612/suction/detach</detach_topic>
      <output_topic>/cs612/suction/state</output_topic>
    </plugin>

  </model>
</sdf>
