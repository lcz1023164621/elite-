    <!--
      末端工具替换为 my_arms/111/夹吸组合夹具 导出的新模型，
      保持 suction_cup_link 名称不变以兼容既有 ROS 话题/MoveIt 配置。
    -->
    <link name="suction_cup_link">
      <pose relative_to="joint_suction_cup">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.1065 0 0 0</pose>
        <mass>0.066436</mass>
        <inertia>
          <ixx>2.91178e-04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.91178e-04</iyy>
          <iyz>0</iyz>
          <izz>8.00000e-05</izz>
        </inertia>
      </inertial>
      <visual name="ee_111_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://elite_description/meshes/ec612/ee_111_repaired.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.00 0.42 0.05 1.0</ambient>
          <diffuse>1.00 0.42 0.05 1.0</diffuse>
          <specular>0.18 0.10 0.04 1.0</specular>
          <emissive>0.10 0.03 0.00 1.0</emissive>
        </material>
      </visual>
      <visual name="suction_piston_left">
        <pose>-0.018 0 0.206 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.010</length>
            <radius>0.003</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.82 0.95 1.0</ambient>
          <diffuse>0.05 0.82 0.95 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>
      </visual>
      <visual name="suction_piston_right">
        <pose>0.018 0 0.206 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.010</length>
            <radius>0.003</radius>
          </cylinder>
        </geometry>
        <material>
