          <diffuse>0.05 0.82 0.95 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>
      </visual>
      <visual name="suction_boot_left">
        <pose>-0.018 0 0.211 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.006</length>
            <radius>0.006</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.93 0.10 1.0</ambient>
          <diffuse>0.95 0.93 0.10 1.0</diffuse>
        </material>
      </visual>
      <visual name="suction_boot_right">
        <pose>0.018 0 0.211 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.006</length>
            <radius>0.006</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.93 0.10 1.0</ambient>
          <diffuse>0.95 0.93 0.10 1.0</diffuse>
        </material>
      </visual>
      <visual name="suction_lip_left">
        <pose>-0.018 0 0.214 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.003</length>
            <radius>0.009</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.92 0.10 0.10 1.0</ambient>
          <diffuse>0.92 0.10 0.10 1.0</diffuse>
        </material>
      </visual>
      <visual name="suction_lip_right">
        <pose>0.018 0 0.214 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.003</length>
            <radius>0.009</radius>
          </cylinder>
        </geometry>
        <material>
