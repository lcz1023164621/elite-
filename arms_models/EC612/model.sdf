    <joint name="joint_suction_cup" type="fixed">
      <pose relative_to="link6">0 0 0 0 0 0</pose>
      <parent>link6</parent>
      <child>suction_cup_link</child>
    </joint>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher"/>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/model/EC612_arm/joint/joint1/0/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>380</p_gain>
      <i_gain>3.0</i_gain>
      <d_gain>90</d_gain>
      <i_max>80</i_max>
      <i_min>-80</i_min>
      <cmd_max>436</cmd_max>
      <cmd_min>-436</cmd_min>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system"
