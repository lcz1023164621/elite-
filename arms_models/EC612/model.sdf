          <iyz>-2.89514354564923e-06</iyz>
          <izz>0.00399062567997713</izz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>package://elite_description/meshes/ec612/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="base_link_collision">
        <geometry>
          <mesh>
            <uri>package://elite_description/meshes/ec612/base_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- link1 -->
    <link name="link1">
      <pose relative_to="joint1">0 0 0 0 0 0</pose>
