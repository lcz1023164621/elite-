    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>suction_cup_link</parent_link>
      <child_model>rect_pickup</child_model>
      <child_link>box_link</child_link>
      <attach_topic>/ec612/suction/attach</attach_topic>
      <detach_topic>/ec612/suction/detach</detach_topic>
      <output_topic>/ec612/suction/state</output_topic>
    </plugin>

