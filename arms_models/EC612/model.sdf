<?xml version="1.0"?>
<sdf version="1.7">
  <model name="EC612">
    <static>false</static>
    <joint name="world_fixed" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <!-- base_link -->
    <link name="base_link">
      <inertial>
        <pose>5.67149240033586e-05 -0.000105244825639109 0.0659791955027099 0 0 0</pose>
        <mass>0.948882914788405</mass>
        <inertia>
          <ixx>0.00296071190840501</ixx>
          <ixy>-1.01895818620175e-06</ixy>
          <ixz>5.26854170304019e-06</ixz>
