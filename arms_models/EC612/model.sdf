    <joint name="joint1" type="revolute">
      <pose relative_to="base_link">0 0 0.193 0 0 1.5708</pose>
      <parent>base_link</parent>
      <child>link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>436</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics><damping>5</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

