<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="arm_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"/>

    <!-- 光照 -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- 地面：内嵌平面，避免依赖 model://ground_plane（需额外 Fuel/模型路径） -->
    <model name="ground_plane">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.78 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 待抓取矩形物体：初始放在 carton_box 正中央，供 1 号机械臂从箱内抓取 -->
    <model name="rect_pickup">
      <pose>-0.82 0.30 0.046 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.000542</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000967</iyy><iyz>0</iyz>
            <izz>0.001242</izz>
          </inertia>
        </inertial>
        <collision name="box_collision">
          <geometry>
            <box><size>0.20 0.14 0.08</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>5.0</mu>
                <mu2>5.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000</kp>
                <kd>1000</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box><size>0.20 0.14 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.45 0.2 1</ambient>
            <diffuse>0.9 0.5 0.22 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- 发布模型位姿到 /model/rect_pickup/pose（供 ros_gz_bridge → ROS） -->
      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="ignition::gazebo::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
      </plugin>
    </model>

    <!-- 透明纸箱：关于 1 号机械臂基准轴镜像到另一侧，rect_pickup 初始位于箱体中央 -->
    <model name="carton_box">
      <pose>-0.82 0.30 0 0 0 0</pose>
      <static>true</static>
      <link name="base">
        <visual name="floor">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry>
            <box><size>0.42 0.30 0.006</size></box>
          </geometry>
          <material>
            <ambient>0.92 0.88 0.75 0.22</ambient>
            <diffuse>0.95 0.9 0.8 0.25</diffuse>
          </material>
        </visual>
        <collision name="floor_c">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry>
            <box><size>0.42 0.30 0.006</size></box>
          </geometry>
        </collision>
        <!-- 四面薄壁 -->
        <visual name="wall_px">
          <pose>0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
          <material>
            <ambient>0.92 0.88 0.75 0.18</ambient>
            <diffuse>0.95 0.9 0.8 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_px_c">
          <pose>0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
        </collision>
        <visual name="wall_nx">
          <pose>-0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
          <material>
            <ambient>0.92 0.88 0.75 0.18</ambient>
            <diffuse>0.95 0.9 0.8 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_nx_c">
          <pose>-0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
        </collision>
        <visual name="wall_py">
          <pose>0 0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
          <material>
            <ambient>0.92 0.88 0.75 0.18</ambient>
            <diffuse>0.95 0.9 0.8 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_py_c">
          <pose>0 0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
        </collision>
        <visual name="wall_ny">
          <pose>0 -0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
          <material>
            <ambient>0.92 0.88 0.75 0.18</ambient>
            <diffuse>0.95 0.9 0.8 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_ny_c">
          <pose>0 -0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
        </collision>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="ignition::gazebo::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>true</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>2</static_update_frequency>
      </plugin>
    </model>

    <!-- 第二个透明容器：供 cs612_2 在传送带末端接力放置 rect_pickup -->
    <model name="box2">
      <pose>2.90000 0.00000 0 0 0 0</pose>
      <static>true</static>
      <link name="base">
        <visual name="floor">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry>
            <box><size>0.42 0.30 0.006</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.90 0.95 0.22</ambient>
            <diffuse>0.75 0.95 1.00 0.25</diffuse>
          </material>
        </visual>
        <collision name="floor_c">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry>
            <box><size>0.42 0.30 0.006</size></box>
          </geometry>
        </collision>
        <visual name="wall_px">
          <pose>0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
          <material>
            <ambient>0.75 0.90 0.95 0.18</ambient>
            <diffuse>0.75 0.95 1.00 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_px_c">
          <pose>0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
        </collision>
        <visual name="wall_nx">
          <pose>-0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
          <material>
            <ambient>0.75 0.90 0.95 0.18</ambient>
            <diffuse>0.75 0.95 1.00 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_nx_c">
          <pose>-0.206 0 0.110 0 0 0</pose>
          <geometry><box><size>0.008 0.30 0.22</size></box></geometry>
        </collision>
        <visual name="wall_py">
          <pose>0 0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
          <material>
            <ambient>0.75 0.90 0.95 0.18</ambient>
            <diffuse>0.75 0.95 1.00 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_py_c">
          <pose>0 0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
        </collision>
        <visual name="wall_ny">
          <pose>0 -0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
          <material>
            <ambient>0.75 0.90 0.95 0.18</ambient>
            <diffuse>0.75 0.95 1.00 0.2</diffuse>
          </material>
        </visual>
        <collision name="wall_ny_c">
          <pose>0 -0.146 0.110 0 0 0</pose>
          <geometry><box><size>0.42 0.008 0.22</size></box></geometry>
        </collision>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="ignition::gazebo::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>true</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>2</static_update_frequency>
      </plugin>
    </model>

    <!-- 机器人由 cs612_moveit_config/launch/bringup.launch.py 通过官方 Elite Xacro
         和 ros_gz_sim create 生成。cs612 与 cs612_2 都是真实可控模型。 -->

    <!--
      多机械臂布局参考：
      1 号机械臂 cs612 由 bringup.launch.py 动态生成在 base_link/world 原点。
      2 号机械臂 cs612_2 由 bringup.launch.py 动态生成在传送带另一侧，使用独立 ros2_control。
    -->
    <!-- 中间传送带：位于 arm1 (cs612) 与 arm2 (cs612_2) 之间的几何中点，
         方向与两机械臂连线一致。模型原点在底面中心。 -->
    <include>
      <name>middle_conveyor</name>
      <uri>model://middle_conveyor</uri>
      <pose>1.00825 -0.35547 0.0 0 0 -0.338955</pose>
    </include>

    <!-- GUI 配置：内嵌 JointPositionController 面板 -->
    <gui fullscreen="0">

      <!-- 3D 场景视图 -->
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>2.5 -2.5 2.0 0 0.5 2.4</camera_pose>
      </plugin>

      <!-- 播放控制条 -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- 实体树 -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>

    </gui>

  </world>
</sdf>
